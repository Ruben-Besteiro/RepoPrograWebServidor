PATCH https://repoprograwebservidor-production.up.railway.app/api/project/69ee0eac2b5a55f20eed61bc
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Proyecto 1 Actualizado",
    "client": "69ee0eac2b5a55f20eed61ba"
}

