### Registrar usuario (hay que verificarlo)
POST http://localhost:3000/api/user/register
Content-Type: application/json

{
    "email": "willyrex@gmail.com",
    "password": "QueVivaElMaincra69@",
    "name": "Willy",
    "lastName": "Rex",
    "nif": "12345678A",
    "address": {
        "street": "Calle Ñ",
        "number": 123,
        "postal": 28001,
        "city": "Madrid",
        "province": "Madrid"
    }
}

### Verificar al usuario que tiene el token
PUT http://localhost:3000/api/user/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "verificationCode": 661561
}

### Login
### No utiliza el token ni tampoco ningún middleware
POST http://localhost:3000/api/user/login
Content-Type: application/json

{
    "email": "willyrex@gmail.com",
    "password": "QueVivaElMaincra69@"
}

### Actualizar el usuario que tiene el token
### PUT normalmente borra los campos que faltan
### pero aquí no porque estoy usando Object.assign
PUT http://localhost:3000/api/user
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Vegetta",
    "lastName": "777",
    "nif": "12345678A",
    "address": {
        "street": "Calle Ñ",
        "number": 123,
        "postal": 28001,
        "city": "Madrid",
        "province": "Madrid"
    }
}

### Meter a un usuario en una compañía
PATCH http://localhost:3000/api/user/company
Authorization: Bearer {{token}}
Content-Type: application/json

{
    // ID inventado
    "company": "69d0e7e4d06b8140f7fc6603"
}

### Obtener usuarios (ruta protegida)
GET http://localhost:3000/api/user
Authorization: Bearer {{token}}

### Obtener los datos del usuario que tiene el token
GET http://localhost:3000/api/user/me
Authorization: Bearer {{token}}

### Obtener usuarios sin token (debe dar 401)
GET http://localhost:3000/api/user

### REFRESH TOKEN (genera nuevo accessToken)
POST http://localhost:3000/api/user/refresh
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

### LOGOUT (revoca refresh token)
POST http://localhost:3000/api/user/logout
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

### CERRAR TODAS LAS SESIONES (necesita accessToken)
POST http://localhost:3000/api/user/logout-all
Authorization: Bearer {{token}}

### Borrar usuario por ID
#DELETE http://localhost:3000/api/user?soft=false
#Authorization: Bearer {{token}}
#Content-Type: application/json

#{
#    "id": "69d0d997603bbddcb8b9292f"
#}

### Soft delete
DELETE http://localhost:3000/api/user?soft=true
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "69d0dac112c27a9a11bffbb4"
}

### Restaurar un usuario que fue soft deleteado
PUT http://localhost:3000/api/user/restore
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "id": "69d0dac112c27a9a11bffbb4"
}

### Crear compañía (ruta protegida)
POST http://localhost:3000/api/company
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Mi Empresa",
    "cif": "E12345678",
    "address": {
        "street": "Calle Falsa",
        "number": 123,
        "postal": 28001,
        "city": "Madrid",
        "province": "Madrid"
    },
    "logo": "https://example.com/logo.png",
    "isFreelance": false
}

### Actualizar compañía (ruta protegida)
PUT http://localhost:3000/api/company/69d0dbd364ffef7c376a4d4c
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Mi Empresa Actualizada",
    "cif": "E12345678",
    "address": {
        "street": "Calle Falsa",
        "number": 123,
        "postal": 28001,
        "city": "Madrid",
        "province": "Madrid"
    },
    "logo": "https://example.com/logo.png",
    "isFreelance": false
}

### Obtener compañías (ruta protegida)
GET http://localhost:3000/api/company
Authorization: Bearer {{token}}

### Soft delete de la compañía (ruta protegida)
DELETE http://localhost:3000/api/company/69d0dbd364ffef7c376a4d4c?soft=true
Authorization: Bearer {{token}}

### Hard delete de la compañía (ruta protegida)
DELETE http://localhost:3000/api/company/69d0dbd364ffef7c376a4d4c?soft=false
Authorization: Bearer {{token}}
