model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)

  // Relaciones
  loans     Loan[]
  reviews   Review[]

  @@map("users")
}

enum Role {
  USER
  LIBRARIAN
  ADMIN
}